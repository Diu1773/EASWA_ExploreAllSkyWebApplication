# Local development defaults
EASWA_DEBUG=true
EASWA_HOST=0.0.0.0
EASWA_PORT=5895
EASWA_BASE_URL=http://localhost:5895
EASWA_SESSION_SECRET=easwa-dev-secret-change-me

# Optional Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Runtime storage
EASWA_DB_PATH=./easwa.dev.db
EASWA_EXPORT_DIR=./submissions-dev

# Transit performance knobs
EASWA_TRANSIT_PREVIEW_WORKERS=2
EASWA_TRANSIT_FRAME_COUNT_WORKERS=4
EASWA_TRANSIT_CUTOUT_MEMORY_CACHE_MAX_ITEMS=4
EASWA_TRANSIT_CUTOUT_MEMORY_CACHE_MAX_BYTES=209715200
EASWA_TRANSIT_CUTOUT_HOT_CACHE_MAX_ITEMS=1
# Stream the TESSCut ZIP/FITS through a temp file during loading instead of RAM.
# Keeps the load step from spiking memory. Independent of the persistent cache.
EASWA_TRANSIT_CUTOUT_STAGE_TO_DISK=true
# EASWA_TRANSIT_CUTOUT_STAGE_DIR=/tmp/easwa-transit-staging
# Max TESSCut ZIP download size in bytes (0 = unlimited). Guards staging disk on
# small hosts; oversized cutouts fail fast instead of filling the disk.
# EASWA_TRANSIT_CUTOUT_MAX_DOWNLOAD_BYTES=0

# Global concurrency caps for the CPU-bound NDJSON streams (IP-independent —
# per-IP rate limits are defeated behind the Render proxy; see
# docs/LOAD_TEST_2026-07.md). Bare names FIT_MAX_CONCURRENCY /
# PHOTOMETRY_MAX_CONCURRENCY are also accepted.
# EASWA_FIT_MAX_CONCURRENCY=3
# EASWA_PHOTOMETRY_MAX_CONCURRENCY=8
# EASWA_STREAM_QUEUE_WAIT_SECONDS=90

# Transit fit engine: MCMC refinement is opt-in (default off = least squares +
# Jacobian uncertainties; ~5x faster per fit). Bare names FIT_MCMC_* also work.
# EASWA_FIT_MCMC_DEFAULT=false
# EASWA_FIT_MCMC_WALKERS=16
# EASWA_FIT_MCMC_STEPS=500

# App behavior
EASWA_RECORD_REQUIRE_LOGIN=true
EASWA_ADMIN_EMAILS=teacher@example.com
