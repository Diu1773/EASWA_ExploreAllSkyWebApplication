# Vite 환경변수 템플릿 — 실제 값은 frontend/.env (커밋 금지)에 두고,
# 프로덕션은 Render 대시보드 Environment에 설정 후 재배포.
# Vite 변수는 빌드 시점에 번들에 박히므로 값 변경 후 반드시 npm run build.

# 익명 결과 제출 수신부 (docs/survey/easwa_record_sink.gs 를 웹 앱으로 배포한 URL).
# 비어 있으면 Step 6의 '결과 제출 (익명)' 버튼이 비활성(제출 서버 미설정)으로 표시됨.
VITE_RECORD_SINK_URL=

# 제출 레코드에 함께 기록되는 앱 버전 태그 (미설정 시 'dev')
VITE_APP_VERSION=
